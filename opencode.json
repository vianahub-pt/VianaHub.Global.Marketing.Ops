{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "subagent_depth": 1,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.env.example": "allow",
      "**/*.env.example": "allow",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "*.p12": "deny",
      "**/*.p12": "deny",
      "*.pfx": "deny",
      "**/*.pfx": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny"
    }
  }
}
