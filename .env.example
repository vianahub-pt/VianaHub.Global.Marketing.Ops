# ============================================
# VianaHub Global Marketing Ops - Environment
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env or .env.local files.

# Platform credentials (examples)
# CYLEX_EMAIL=
# CYLEX_PASSWORD=
# HOTFROG_API_KEY=

# Browser settings
# HEADLESS=true
# BROWSER_TIMEOUT=60000

# Debug
# DEBUG=false
# LOG_LEVEL=info

# SQL Server (Sprint 5) - names match the GitHub configuration (placeholders only)
# Replace the values in your local .env / secret store. NEVER commit real values.
# SQL_SERVER_HOST=
# SQL_SERVER_PORT=1433
# SQL_SERVER_DATABASE=opsdb
# SQL_SERVER_USER=
# SQL_SERVER_PASSWORD=

# Persistence provider: filesystem | sqlserver
# Default (unset or filesystem) keeps the backward-compatible filesystem repositories.
# PERSISTENCE_PROVIDER=filesystem
