{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "."
  },
  "include": ["automation/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "playwright-report",
    "test-results",
    "blob-report",
